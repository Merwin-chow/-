{
  "bsonType": "object",
  "required": ["_id"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "key": {
      "bsonType": "string",
      "description": "凭据key，格式：uni-id:[dcloudAppid]:[platform]:[openid]:[type]"
    },
    "value": {
      "bsonType": "object",
      "description": "凭据内容，如 access_token"
    },
    "expiresIn": {
      "bsonType": "number",
      "description": "有效时长（秒）"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "expireTime": {
      "bsonType": "timestamp",
      "description": "过期时间"
    }
  }
}
