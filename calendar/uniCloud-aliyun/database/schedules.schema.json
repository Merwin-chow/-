{
	"bsonType": "object",
	"required": ["owner_id", "title", "date"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": { "description": "文档内置ID" },
		"owner_id": { "bsonType": "string", "description": "创建者ID" },
		"title": { "bsonType": "string", "description": "日程标题" },
		"date": { "bsonType": "string", "description": "日期 YYYY-MM-DD" },
		"start_time": { "bsonType": "string", "description": "开始时间 HH:mm" },
		"end_time": { "bsonType": "string", "description": "结束时间 HH:mm（可选）" },
		"type": { "bsonType": "string", "description": "类型：birthday/event/meeting/other" },
		"scope": { "bsonType": "string", "description": "范围：private/group" },
		"group_id": { "bsonType": "string", "description": "所属群组ID（scope=group 时必填）" },
		"signup_enabled": { "bsonType": "bool", "description": "是否启用报名（群日程）" },
		"signup_quota": { "bsonType": "int", "description": "名额上限，0=不限" },
		"signup_count": { "bsonType": "int", "description": "当前已报名人数（原子计数，并发报名不超卖）" },
		"signup_fields": {
			"bsonType": "array",
			"items": { "bsonType": "string" },
			"description": "需填写字段键名（兼容旧数据，新数据由 signup_form 派生）"
		},
		"signup_form": {
			"bsonType": "array",
			"items": {
				"bsonType": "object",
				"properties": {
					"key": { "bsonType": "string", "description": "字段标识，存储到 form_data 的键" },
					"label": { "bsonType": "string", "description": "显示名" },
					"type": { "bsonType": "string", "description": "text/textarea/number/date/select/checkbox" },
					"required": { "bsonType": "bool", "description": "是否必填" },
					"options": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "select 选项" },
					"prefill": { "bsonType": "string", "description": "预填来源 group/profile/manual" },
					"save_to_profile": { "bsonType": "string", "description": "写回档案的字段名，如 birthday" }
				}
			},
			"description": "通用报名问卷定义"
		},
		"signup_deadline": { "bsonType": "string", "description": "报名截止日期（可选，YYYY-MM-DD）" },
		"sessions": {
			"bsonType": "array",
			"items": {
				"bsonType": "object",
				"properties": {
					"name": { "bsonType": "string", "description": "场次名" },
					"quota": { "bsonType": "int", "description": "场次名额，0=不限" },
					"start_time": { "bsonType": "string", "description": "开始时间 HH:mm" },
					"end_time": { "bsonType": "string", "description": "结束时间 HH:mm" }
				}
			},
			"description": "场次配置"
		},
		"signup_closed": { "bsonType": "bool", "description": "是否已关闭报名（满员自动或手动）" },
		"reminders": {
			"bsonType": "array",
			"items": {
				"bsonType": "object",
				"properties": {
					"minutes_before": { "bsonType": "int", "description": "提前分钟数" },
					"sent": { "bsonType": "bool", "description": "是否已发送提醒" }
				}
			},
			"description": "定时提醒配置"
		},
		"next_remind_at": {
			"bsonType": "timestamp",
			"description": "下一次提醒触发时间戳（毫秒）；0 表示无待发提醒，供 schedule_notify 索引查询"
		},
		"member_name": { "bsonType": "string", "description": "关联成员名（如生日归属人）" },
		"description": { "bsonType": "string", "description": "详细描述" },
		"createTime": { "bsonType": "timestamp", "description": "创建时间" },
		"updateTime": { "bsonType": "timestamp", "description": "更新时间" }
	}
}
