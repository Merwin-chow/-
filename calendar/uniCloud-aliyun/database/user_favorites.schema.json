{
	"bsonType": "object",
	"required": ["user_id", "date", "content"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "文档内置ID"
		},
		"user_id": {
			"bsonType": "string",
			"description": "用户ID（openid）"
		},
		"date": {
			"bsonType": "string",
			"description": "收藏日期 YYYY-MM-DD"
		},
		"content": {
			"bsonType": "string",
			"description": "金句内容"
		},
		"content_hash": {
			"bsonType": "string",
			"description": "content 的 SHA256 摘要，用于 (user_id,date,content_hash) 唯一索引做查重"
		},
		"author": {
			"bsonType": "string",
			"description": "作者"
		},
		"source": {
			"bsonType": "string",
			"description": "来源标识"
		},
		"createTime": {
			"bsonType": "timestamp",
			"description": "收藏时间"
		}
	}
}
